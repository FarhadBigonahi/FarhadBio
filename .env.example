# Frontend (Vercel) environment.
#
# NOTE what is NOT here any more: ADMIN_PASSWORD, AUTH_SECRET, DATABASE_URL.
# Those moved to the backend (server/.env). The frontend now holds no secrets
# at all — it only needs to know where the API lives.

# Public API base URL. Also inlined into the browser bundle for the analytics
# beacon, so it must be the publicly reachable origin.
NEXT_PUBLIC_API_URL=https://api.farhad.bio

# Optional. If set, server-side rendering and the admin proxy use this instead
# of the public URL — e.g. to bypass Cloudflare and hit the origin directly.
# API_INTERNAL_URL=
