# farhadbio-api — copy to .env and fill in. NEVER commit the real .env.
# Every value below is read once at boot by src/config.ts and validated.
# This file is the ONLY thing tying the service to a particular machine —
# that is what makes the backend portable (see deploy/README.md).

# --- runtime ---
NODE_ENV=production
# Bound to loopback only; nginx is the one thing that talks to it publicly.
HOST=127.0.0.1
PORT=3010
LOG_LEVEL=info

# --- data ---
# SQLite file. Relative paths resolve against DATA_DIR, not the cwd, so the
# database survives an atomic release swap (releases/<sha> changes every deploy).
# Point this at a libsql://... URL + token to move to Turso with zero code edits.
DATABASE_URL=file:farhadbio.db
DATABASE_AUTH_TOKEN=
# Absolute path to persistent state that must OUTLIVE a deploy.
DATA_DIR=/home/deploy/apps/farhadbio-api/shared/data

# --- auth ---
# The password you type at /admin/login.
ADMIN_PASSWORD=
# HMAC key that signs admin session tokens. Min 32 chars. Rotating it logs
# every admin session out immediately, which is the intended panic button.
AUTH_SECRET=
SESSION_DAYS=7

# --- http ---
# Exact origins allowed to call this API from a browser (comma separated).
# The analytics beacon is sent straight from the visitor's browser, so the
# public site origin MUST be listed here.
CORS_ORIGINS=https://farhad.bio,https://www.farhad.bio
# Trust X-Forwarded-For / CF-Connecting-IP. True because nginx + Cloudflare
# sit in front. Set false if you ever expose the port directly.
TRUST_PROXY=true

# --- analytics retention ---
# 0 = keep every pageview forever. Set to e.g. 400 to auto-delete rows older
# than 400 days (privacy stance + keeps the SQLite file from growing forever).
EVENT_RETENTION_DAYS=0
