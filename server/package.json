{
  "name": "farhadbio-api",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone backend for farhad.bio — blog content + first-party analytics.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "migrate": "node --env-file=.env dist/scripts/migrate.js",
    "seed": "node --env-file=.env dist/scripts/seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@libsql/client": "^0.17.4",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
